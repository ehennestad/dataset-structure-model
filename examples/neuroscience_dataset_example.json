{
  "schemaVersion": "1.0.0",
  "entityTypes": [
    {
      "name": "subject",
      "description": "A research subject (mouse)",
      "isPrimary": true,
      "identifierRef": "subject_id"
    },
    {
      "name": "session",
      "description": "A single experimental recording session",
      "identifierRef": "session_id"
    },
    {
      "name": "recording",
      "description": "An individual imaging recording within a session",
      "identifierRef": "recording_id"
    }
  ],
  "entityRelationships": [
    {
      "sourceEntity": "subject",
      "targetEntity": "session",
      "relationType": "oneToMany",
      "relationName": "hasSessions",
      "description": "A subject can have multiple recording sessions"
    },
    {
      "sourceEntity": "session",
      "targetEntity": "recording",
      "relationType": "oneToMany",
      "relationName": "hasRecordings",
      "description": "A session can have multiple recordings"
    }
  ],
  "metadataDefinitions": {
    "subject_id": {
      "name": "Subject ID",
      "ofEntity": "subject",
      "dataType": "string",
      "description": "Unique identifier for research subjects",
      "validation": {
        "pattern": "^[A-Za-z0-9]+$",
        "minLength": 3
      }
    },
    "acquisition_date": {
      "name": "Acquisition Date",
      "ofEntity": "session",
      "dataType": "date",
      "description": "Date when the session data was acquired"
    },
    "session_id": {
      "name": "Session ID",
      "ofEntity": "session",
      "dataType": "string",
      "description": "Unique identifier for experimental sessions"
    },
    "recording_id": {
      "name": "Recording ID",
      "ofEntity": "recording",
      "dataType": "string",
      "description": "Identifier for individual recordings within a session"
    },
    "imaging_depth": {
      "name": "Imaging Depth",
      "ofEntity": "recording",
      "dataType": "number",
      "unit": "µm",
      "description": "Depth of two-photon imaging plane below the cortical surface",
      "validation": {
        "minimum": 0,
        "maximum": 1000
      }
    },
    "frame_rate": {
      "name": "Frame Rate",
      "ofEntity": "recording",
      "dataType": "number",
      "unit": "Hz",
      "description": "Imaging frame rate"
    }
  },
  "dataLocations": [
    {
      "identifier": "two-photon-calcium-imaging",
      "displayName": "Two-Photon Calcium Imaging",
      "description": "Raw two-photon calcium imaging recordings from cortical neurons",
      "dataCategory": "raw",
      "tags": ["imaging", "two-photon", "calcium", "raw-data"],
      "customProperties": {
        "microscope": "Bruker",
        "imagingRegion": "cortical layer 2/3"
      },
      "rootStoragePaths": [
        {
          "identifier": "lab-windows-path",
          "path": "D:\\Data\\TwoPhoton",
          "volumeName": "DataDrive",
          "storageType": "local",
          "environment": "windows-lab",
          "priority": 1,
          "isAvailable": true
        },
        {
          "identifier": "analysis-mac-path",
          "path": "/Volumes/DataDrive/TwoPhoton",
          "volumeName": "DataDrive",
          "storageType": "external",
          "environment": "mac-analysis",
          "priority": 1,
          "isAvailable": true
        }
      ],
      "pathTemplate": "{rootPath}/{subject}/{session}/{recording}",
      "entityLayout": [
        {
          "name": "subjects",
          "entityType": "subject",
          "matchPattern": "^[A-Za-z0-9]+$",
          "excludePatterns": ["temp", "test", "backup"],
          "isRequired": true,
          "isVariable": true
        },
        {
          "name": "sessions",
          "entityType": "session",
          "matchPattern": "^\\d{8}_[A-Za-z0-9]+$",
          "isRequired": true,
          "isVariable": true
        },
        {
          "name": "recordings",
          "entityType": "recording",
          "matchPattern": "^[A-Za-z0-9_-]+$",
          "excludePatterns": ["archive"],
          "isRequired": true,
          "isVariable": true,
          "filePatterns": [
            {
              "pattern": ".*\\.tif$",
              "role": "primary",
              "format": "image/tiff",
              "description": "Raw calcium imaging frames, 16-bit single-channel",
              "isRequired": true,
              "groupKey": "imaging-data"
            },
            {
              "pattern": ".*_metadata\\.json$",
              "role": "sidecar",
              "format": "application/json",
              "description": "Acquisition parameters: frame rate, imaging depth, laser power, PMT settings",
              "isRequired": false,
              "groupKey": "imaging-data",
              "metadataExtractors": [
                {
                  "method": "function",
                  "extractorFunction": "extractImagingParameters"
                }
              ]
            }
          ]
        }
      ],
      "metadataMapping": [
        {
          "metadataRef": "subject_id",
          "extraction": {
            "method": "substring",
            "pattern": "0:end",
            "entityLayoutLevel": 0
          }
        },
        {
          "metadataRef": "acquisition_date",
          "extraction": {
            "method": "regex",
            "pattern": "^(\\d{8})_",
            "valueFormat": "yyyyMMdd",
            "entityLayoutLevel": 1
          }
        },
        {
          "metadataRef": "session_id",
          "extraction": {
            "method": "regex",
            "pattern": "^\\d{8}_(.+)$",
            "entityLayoutLevel": 1
          }
        },
        {
          "metadataRef": "recording_id",
          "extraction": {
            "method": "substring",
            "pattern": "0:end",
            "entityLayoutLevel": 2
          }
        }
      ]
    },
    {
      "identifier": "processed-calcium-imaging",
      "displayName": "Processed Calcium Imaging",
      "description": "Motion-corrected and preprocessed calcium imaging data",
      "dataCategory": "processed",
      "derivedFrom": ["two-photon-calcium-imaging"],
      "tags": ["imaging", "two-photon", "calcium", "motion-corrected"],
      "rootStoragePaths": [
        {
          "identifier": "lab-windows-processed",
          "path": "D:\\Data\\Processed\\TwoPhoton",
          "volumeName": "DataDrive",
          "storageType": "local",
          "environment": "windows-lab",
          "priority": 1,
          "isAvailable": true
        }
      ],
      "pathTemplate": "{rootPath}/{subject}/{session}/processed",
      "entityLayout": [
        {
          "name": "subjects",
          "entityType": "subject",
          "matchPattern": "^[A-Za-z0-9]+$",
          "excludePatterns": ["temp", "test", "backup"],
          "isRequired": true,
          "isVariable": true
        },
        {
          "name": "sessions",
          "entityType": "session",
          "matchPattern": "^\\d{8}_[A-Za-z0-9]+$",
          "isRequired": true,
          "isVariable": true
        },
        {
          "name": "processed",
          "entityType": "recording",
          "matchPattern": "^processed$",
          "isRequired": true,
          "isVariable": false,
          "fixedName": "processed",
          "filePatterns": [
            {
              "pattern": ".*_motion_corrected\\.tif$",
              "role": "primary",
              "format": "image/tiff",
              "description": "Motion-corrected calcium imaging frames",
              "isRequired": true
            },
            {
              "pattern": ".*_roi_masks\\.mat$",
              "role": "auxiliary",
              "format": "application/x-matlab-data",
              "description": "ROI segmentation masks from Suite2p or similar",
              "isRequired": false
            },
            {
              "pattern": ".*_calcium_traces\\.mat$",
              "role": "auxiliary",
              "format": "application/x-matlab-data",
              "description": "Extracted dF/F calcium traces per ROI",
              "isRequired": false
            }
          ]
        }
      ],
      "metadataMapping": [
        {
          "metadataRef": "subject_id",
          "extraction": {
            "method": "substring",
            "pattern": "0:end",
            "entityLayoutLevel": 0
          }
        },
        {
          "metadataRef": "acquisition_date",
          "extraction": {
            "method": "regex",
            "pattern": "^(\\d{8})_",
            "valueFormat": "yyyyMMdd",
            "entityLayoutLevel": 1
          }
        },
        {
          "metadataRef": "session_id",
          "extraction": {
            "method": "regex",
            "pattern": "^\\d{8}_(.+)$",
            "entityLayoutLevel": 1
          }
        }
      ]
    }
  ],
  "preferences": {
    "defaultDataLocationIdentifier": "two-photon-calcium-imaging",
    "environmentIdentifier": "windows-lab"
  }
}
